# ==============================================================================
# Autonomous Trading Bot Configuration
# Copy this file to .env and configure your credentials
# ==============================================================================

# EXECUTION_MODE: "MOCK" for risk-free paper trading, "LIVE" for real CoinDCX execution
EXECUTION_MODE=MOCK

# Capital Sizing in INR
INITIAL_CAPITAL_INR=10000.0
STANDARD_MARGIN_WEIGHT=0.10
A_PLUS_MARGIN_WEIGHT=0.15

# CoinDCX Futures API Credentials (Required if EXECUTION_MODE=LIVE)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here
COINDCX_SYMBOL=B-XRP_USDT
COINDCX_REST_BASE=https://api.coindcx.com

# Binance Market Data Feed
BINANCE_SYMBOL=XRPUSDT

# Strategy Parameters
BASE_LEVERAGE=15.0
A_PLUS_LEVERAGE=20.0
TARGET_ROI_PCT=25.0
SL_ROI_PCT=25.0

# Circuit Breakers
MAX_TRADES_PER_DAY=1
MAX_CONSECUTIVE_LOSSES=2
MAX_DRAWDOWN_LOCK_PCT=15.0

# Telegram Telemetry & Alerting (Optional but Recommended)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Persistence & Storage
DATABASE_PATH=data/live_trading.db
MODEL_WEIGHTS_PATH=production/ml/model_weights.pkl
