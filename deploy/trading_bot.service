[Unit]
Description=Autonomous XRP 4H Liquidity Hunting Trading Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/My-Trading-Bot
ExecStart=/home/ubuntu/My-Trading-Bot/.venv/bin/python production/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/My-Trading-Bot/logs/bot_stdout.log
StandardError=append:/home/ubuntu/My-Trading-Bot/logs/bot_stderr.log
EnvironmentFile=/home/ubuntu/My-Trading-Bot/.env

[Install]
WantedBy=multi-user.target
